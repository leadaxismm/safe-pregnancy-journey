# All values here are PUBLIC (they end up in the browser bundle). Never put service-role keys or passwords here.
VITE_SUPABASE_URL=
# Supabase publishable / anon key (public by design; access is enforced by RLS and server-side checks)
VITE_SUPABASE_ANON_KEY=
# preview | production | test  — tags analytics so test data never mixes with real data
VITE_APP_ENV=preview
# true = expose the sample-data dashboard at #/admin-demo (ignored when VITE_APP_ENV=production)
VITE_ENABLE_DEMO_DASHBOARD=false
# Public address of the deployed site (for QR codes)
VITE_PUBLIC_URL=
